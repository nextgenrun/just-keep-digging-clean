# Git ignore for Dig Game Dev Environment

# SSH credentials (sensitive)
_ssh-git/

# Exports (generated/large assets)
exports/

# Git metadata
.git/

# OS files
Thumbs.db
.DS_Store
desktop.ini

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# Logs and temp
*.log
*.tmp
__pycache__/
*.py[cod]

# Local Unreal-generated state
testing/unreal-survival-motion-v2/Binaries/
testing/unreal-survival-motion-v2/DerivedDataCache/
testing/unreal-survival-motion-v2/Intermediate/
testing/unreal-survival-motion-v2/Saved/

# Local gameplay captures (generated by the F10 recorder)
systems/screenrecord/*.webm

dist/
.canary-dist/
.production-stage-*/
archive/sprites/external-reference/  
archive/sprites/character-old-versions/ 
