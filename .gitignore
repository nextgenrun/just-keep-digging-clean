# Git ignore for Dig Game Dev Environment

# SSH credentials (sensitive)
_ssh-git/

# Exports (generated/large assets)
exports/

# Git metadata
.git/

# OS files
Thumbs.db
.DS_Store
desktop.ini

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# Logs and temp
*.log
*.tmp
__pycache__/
*.py[cod]

# Generated local document/render output (not runtime or canonical authoring input)
output/
tmp/
testing/artifacts/

# Local Unreal-generated state
testing/unreal-survival-motion-v2/Binaries/
testing/unreal-survival-motion-v2/DerivedDataCache/
testing/unreal-survival-motion-v2/Intermediate/
testing/unreal-survival-motion-v2/Saved/

# Local gameplay captures (generated by the F10 recorder)
systems/screenrecord/*.webm

dist/
dist-*/
.canary-dist/
.production-stage-*/
archive/sprites/external-reference/  
archive/sprites/character-old-versions/ 

# Repository-local safety reports and temporary recovery metadata
.git-safety/

# Blender creates a numbered autosave beside the canonical editable .blend.
# Canonical .blend sources are preserved with Git LFS; paired autosaves stay local.
*.blend[0-9]*

# Third-party tool checkout; reinstall from its own upstream repository.
tools/video-audio-mcp/

# Third-party Sonniss source bundles stay local. Commit only reviewed/derived
# game-ready audio, manifests, and reproducible import tooling.
sound/library-v2/SoundLibrary_Review/00_INBOX_RAW_EXPORTS/sonniss-gdc2019-recorded-mining-pilot-2026-08-26/source-recordings/
sound/library-v2/SoundLibrary_Review/00_INBOX_RAW_EXPORTS/sonniss-gdc2026-recorded-pilot-2026-08-26/raw/
sound/library-v2/SoundLibrary_Review/00_INBOX_RAW_EXPORTS/sonniss-gdc2026-recorded-pilot-2026-08-26/source-recordings/
