# Keep source and policy files deterministic across Windows and GitHub runners.
* text=auto
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf whitespace=-blank-at-eol,-blank-at-eof
*.mjs text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.tmx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Runtime media stays in normal Git so CI and packaged canaries do not consume
# Git LFS download bandwidth.
*.gif binary
*.jpg binary
*.jpeg binary
*.ogg binary
*.png binary
*.webm binary
*.webp binary

