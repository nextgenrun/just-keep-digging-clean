[
  {"id":"L001","group":"descent","text":"Down we go. Rent won't pay itself.","emotion":"wry","flavour":"work","decision":"pending"},
  {"id":"L002","group":"descent","text":"Underground again. Lovely career choice.","emotion":"dry","flavour":"bad-joke","decision":"pending"},
